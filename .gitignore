*.data
*.image
*.map
*.readelf
*.rpt
*.lib
*.db

# Logs and temporary files
*.log
*.out
*.trace
*.tmp
*.bak

# Python cache and local environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
